{
  "id": "go",
  "match": {"files": ["go.mod"], "globs": ["**/*.go"]},
  "axes": {"intent": true, "correctness": true, "convention": true, "test": true},
  "sandbox": {"copy": [], "setup": ["go build ./..."], "require": []},
  "tests": {
